# Brewfile.personal — the personal machine's packages, applied with
# `brew bundle --file=Brewfile.personal` (bootstrap.sh runs it on a new machine).
# Node, npm and pnpm come from Vite+, which bootstrap.sh installs separately.

# Adopt apps that already exist in /Applications (e.g. installed manually or
# copied by Migration Assistant) instead of failing. If a version mismatch
# still fails one, use: brew install --cask --force <name>
cask_args adopt: true

tap "docker/tap", trusted: true
tap "nikitabobko/tap"

# --- CLI tools -------------------------------------------------------------
brew "betterleaks"
brew "dockutil"
brew "gh"
brew "herdr"
brew "stow"

# --- Fonts -------------------------------------------------------------------
cask "font-fira-code"

# --- Apps --------------------------------------------------------------------
cask "nikitabobko/tap/aerospace"
cask "bruno"
cask "choosy"
cask "claude-code@latest"
cask "codexbar"
cask "docker-desktop"
cask "figma"
cask "firefox"
cask "google-chrome"
cask "karabiner-elements"
cask "proxyman"
cask "raycast"
cask "ghostty"
cask "docker/tap/sbx"
cask "shottr"
cask "zed"
