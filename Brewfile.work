# Brewfile.work — work-machine-only additions, applied by `./bootstrap.sh work`
# after the main Brewfile: brew bundle --file=Brewfile.work
# (Rosetta 2 is not a cask — bootstrap.sh installs it via softwareupdate.)

cask_args adopt: true

tap "atlassian/acli", trusted: true

# --- CLI tools -------------------------------------------------------------
brew "azure-cli"
brew "atlassian/acli/acli"
brew "mise"
brew "yamllint"

# --- Apps --------------------------------------------------------------------
cask "claude"
cask "cursor"
cask "dbeaver-community"
cask "postman"
cask "rider"
